---
import "../styles/global.css";
import type { PageMeta } from "../page-meta.ts";
import { LOCALES, OG_LOCALE, t } from "../i18n.ts";
import { pageUrl } from "../page-meta.ts";
import {
  PWA_APPLE_TOUCH_ICON_HREF,
  PWA_MANIFEST_HREF,
  PWA_THEME_COLOR,
} from "../pwa.ts";

type Props = PageMeta;

const { title, description, url, image, imageAlt, siteName, lang, ogLocale, view } = Astro.props;
const shortName = t(lang, "pwaShortName");
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: siteName,
  url,
  description,
  inLanguage: lang,
  image,
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Any",
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Google Analytics 4 measurement ID: G-L8WKQQFBZC -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-L8WKQQFBZC"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-L8WKQQFBZC");
    </script>
    <meta name="theme-color" content={PWA_THEME_COLOR} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={shortName} />
    <link rel="manifest" href={PWA_MANIFEST_HREF} />
    <link rel="apple-touch-icon" href={PWA_APPLE_TOUCH_ICON_HREF} />
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    {LOCALES.filter((item) => item !== lang).map((item) => (
      <meta property="og:locale:alternate" content={OG_LOCALE[item]} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {LOCALES.map((item) => (
      <link rel="alternate" hreflang={item} href={pageUrl(item, view)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={pageUrl("ja", view)} />
    <script type="application/ld+json" set:html={jsonLd} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700&family=Noto+Sans+KR:wght@400;500;700&family=Noto+Sans+SC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import { registerPwa } from "../pwa.ts";
      registerPwa();
    </script>
  </body>
</html>
