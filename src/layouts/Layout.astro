---
import "../styles/global.css";
import type { PageMeta } from "../page-meta.ts";
import { googleFontsHref } from "../fonts.ts";
import { gtagBootstrapScript, resolveAnalyticsConfig } from "../analytics-config.ts";
import { LOCALES, OG_LOCALE, isJapaneseOnlyView, t } from "../i18n.ts";
import { pageUrl } from "../page-meta.ts";
import {
  PWA_APPLE_TOUCH_ICON_HREF,
  PWA_MANIFEST_HREF,
  PWA_THEME_COLOR,
} from "../pwa.ts";

type Props = PageMeta;

const { title, description, url, image, imageAlt, siteName, lang, ogLocale, view } = Astro.props;
const alternateLocales = isJapaneseOnlyView(view) ? (["ja"] as const) : LOCALES;
const shortName = t(lang, "pwaShortName");
const fontHref = googleFontsHref(lang);
const gtagScript = gtagBootstrapScript(resolveAnalyticsConfig(import.meta.env.PUBLIC_GA4_MEASUREMENT_ID));
const activateStylesheet = "this.media='all'";
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: siteName,
  url,
  description,
  inLanguage: lang,
  image,
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Any",
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Google Analytics 4。本番ホストだけで有効（src/analytics-config.ts）。初回描画を奪わないようアイドル／操作後に載せる。 -->
    <script is:inline set:html={gtagScript} />
    <meta name="theme-color" content={PWA_THEME_COLOR} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={shortName} />
    <link rel="manifest" href={PWA_MANIFEST_HREF} />
    <link rel="apple-touch-icon" href={PWA_APPLE_TOUCH_ICON_HREF} />
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    {alternateLocales.filter((item) => item !== lang).map((item) => (
      <meta property="og:locale:alternate" content={OG_LOCALE[item]} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {alternateLocales.map((item) => (
      <link rel="alternate" hreflang={item} href={pageUrl(item, view)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={pageUrl("ja", view)} />
    <script type="application/ld+json" set:html={jsonLd} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {view === "maker" ? <link rel="preload" as="image" href="/jump-loop-still.png" /> : null}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontHref} media="print" onload={activateStylesheet} />
    <noscript>
      <link rel="stylesheet" href={fontHref} />
    </noscript>
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import { registerPwa } from "../pwa.ts";
      registerPwa();
    </script>
  </body>
</html>
