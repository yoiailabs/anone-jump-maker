---
import Layout from "../layouts/Layout.astro";
import MakerApp from "./MakerApp.tsx";
import HomePage from "./HomePage.tsx";
import { pageMeta } from "../page-meta.ts";
import type { AppView, Locale } from "../i18n.ts";

type Props = {
  locale: Locale;
  view: AppView;
};

const { locale, view } = Astro.props;
const meta = pageMeta(locale, view);

---

<Layout {...meta}>
  <div id="app">
    {view === "home" ? <HomePage client:load locale={locale} /> : <MakerApp client:load locale={locale} />}
  </div>
</Layout>
