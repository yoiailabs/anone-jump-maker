---
import Layout from "../layouts/Layout.astro";
import TermsArticle from "./TermsArticle.tsx";
import { pageMeta } from "../page-meta.ts";
import type { Locale } from "../i18n.ts";

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const meta = pageMeta(locale, "terms");
---

<Layout {...meta}>
  <TermsArticle client:load locale={locale} />
</Layout>
