{
  "name": "anone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "あのねジャンプメーカー — ブラウザだけで写真を差し込むジャンプ動画メーカー（試作）",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && tsc --noEmit -p worker/tsconfig.json && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4173",
    "check": "astro check && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:browser && pnpm test:e2e",
    "og": "node scripts/render-og.mjs",
    "deploy": "pnpm build && wrangler deploy",
    "dev:worker": "pnpm build && wrangler dev -c wrangler.toml"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "playwright": "^1.55.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.37.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "@base-ui/react": "^1.8.0",
    "@sentry/browser": "^10.75.0",
    "astro": "^7.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "heic-to": "1.5.2",
    "lucide-react": "^1.47.0",
    "mediabunny": "^1.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  }
}
