{
  "name": "anone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "あのねジャンプメーカー — ブラウザだけで写真を差し込むジャンプ動画メーカー（試作）",
  "scripts": {
    "dev": "cf dev",
    "build": "astro check && tsc --noEmit -p worker/tsconfig.json && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4173",
    "check": "astro check && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "test:browser": "ANONE_BROWSER=chromium vitest run --config vitest.browser.config.ts && ANONE_BROWSER=webkit vitest run --config vitest.browser.config.ts",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:browser && pnpm test:e2e",
    "og": "node scripts/render-og.mjs",
    "icons": "node scripts/render-pwa-icons.mjs",
    "types": "cf workers types",
    "deploy": "pnpm build && wrangler deploy",
    "dev:worker": "pnpm build && wrangler dev -c wrangler.toml"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "cf": "1.0.0-beta.16",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.150.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/browser": "^11.7.0",
    "astro": "^7.3.8",
    "budoux": "^0.9.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "heic-to": "1.6.6",
    "lucide-react": "^1.56.0",
    "mediabunny": "^1.61.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.3"
  }
}
