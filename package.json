{
  "name": "anone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "あのねジャンプメーカー — ブラウザだけで写真を差し込むジャンプ動画メーカー（試作）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:browser && pnpm test:e2e",
    "og": "node scripts/render-og.mjs",
    "deploy": "pnpm build && wrangler deploy",
    "dev:worker": "pnpm build && wrangler dev -c wrangler.toml"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.37.1",
    "@playwright/test": "^1.55.0",
    "playwright": "^1.55.0",
    "@vitest/browser": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "dependencies": {
    "@sentry/browser": "^10.75.0",
    "heic-to": "1.5.2",
    "mediabunny": "^1.57.0"
  }
}
